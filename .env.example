# ===== Telegram =====
# Токен бота от @BotFather (обязателен в проде — им подписывается initData WebApp)
BOT_TOKEN=123456:CHANGE_ME

# Публичный HTTPS-URL, на котором отдаётся Mini App (нужен Telegram для кнопки WebApp).
# Локально удобно прокинуть туннелем (ngrok/cloudflared) на http://localhost:8000
WEBAPP_URL=https://example.com

# ===== База данных =====
# Прод (Postgres, async-драйвер asyncpg):
DATABASE_URL=postgresql+asyncpg://curator:curator@db:5432/curator
# Локально без Postgres можно так:
# DATABASE_URL=sqlite+aiosqlite:///./curator.db

# ===== Доступ / роли =====
# Telegram ID администраторов через запятую — получают роль admin при первом входе.
ADMIN_TG_IDS=

# ===== Режим разработки =====
# DEV_MODE=true отключает проверку подписи initData и пускает по DEV_TG_ID.
# По умолчанию false (безопасно). true — ТОЛЬКО для локальной отладки в браузере.
DEV_MODE=false
DEV_TG_ID=100001

# Требовать модерацию админом перед публикацией мероприятий (F8/F9)
REQUIRE_MODERATION=false

# ===== Параметры расчёта свободных часов =====
# Границы "учебного дня" (кампусные часы), в которых ищем свободные окна.
DAY_START=08:00
DAY_END=21:00
# Часовой пояс кампуса
TIMEZONE=Europe/Moscow
# Горизонт ленты/свободных часов, дней
HORIZON_DAYS=7
